{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probavi.dev/schemas/adapter/sandbox-call.json",
  "title": "Probavi adapter protocol v0 — sandbox call (adapter → core)",
  "description": "A core-mediated sandbox verb request (adapter-protocol.md §3.2, §4). Valid only during provision, healthcheck, and teardown; at most one outstanding call.",
  "$comment": "Derived from docs/adapter-protocol.md, which is normative. On any disagreement the markdown document wins.",
  "type": "object",
  "properties": {
    "protocol": { "const": "probavi-adapter/0" },
    "request_id": { "type": "string", "minLength": 1 },
    "sandbox_call": {
      "type": "object",
      "properties": {
        "call_id": { "type": "string", "minLength": 1 },
        "verb": { "enum": ["exec", "put_file"] },
        "args": { "type": "object" }
      },
      "required": ["call_id", "verb", "args"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "verb": { "const": "exec" } } },
          "then": { "properties": { "args": { "$ref": "#/$defs/execArgs" } } }
        },
        {
          "if": { "properties": { "verb": { "const": "put_file" } } },
          "then": { "properties": { "args": { "$ref": "#/$defs/putFileArgs" } } }
        }
      ]
    }
  },
  "required": ["protocol", "request_id", "sandbox_call"],
  "additionalProperties": false,
  "$defs": {
    "execArgs": {
      "title": "exec verb args (§4.1)",
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Command and arguments; executed directly, no shell."
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "stdin_b64": { "$ref": "#/$defs/base64" },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["argv"],
      "additionalProperties": false
    },
    "putFileArgs": {
      "title": "put_file verb args (§4.2)",
      "type": "object",
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "dest_path": { "type": "string", "minLength": 1 },
        "mode": {
          "type": "string",
          "pattern": "^0?[0-7]{3}$",
          "description": "Octal string; default \"0600\"."
        }
      },
      "required": ["source_path", "dest_path"],
      "additionalProperties": false
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
