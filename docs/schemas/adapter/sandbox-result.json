{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probavi.dev/schemas/adapter/sandbox-result.json",
  "title": "Probavi adapter protocol v0 — sandbox result (core → adapter)",
  "description": "The core's answer to a sandbox call (adapter-protocol.md §3.3, §4). The value shape depends on the verb of the matching call; exec and put_file values have disjoint required fields, so the anyOf below is unambiguous.",
  "$comment": "Derived from docs/adapter-protocol.md, which is normative. On any disagreement the markdown document wins.",
  "type": "object",
  "properties": {
    "protocol": { "const": "probavi-adapter/0" },
    "request_id": { "type": "string", "minLength": 1 },
    "sandbox_result": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "call_id": { "type": "string", "minLength": 1 },
            "ok": { "const": true },
            "value": {
              "anyOf": [
                { "$ref": "#/$defs/execValue" },
                { "$ref": "#/$defs/putFileValue" }
              ]
            }
          },
          "required": ["call_id", "ok", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "call_id": { "type": "string", "minLength": 1 },
            "ok": { "const": false },
            "error": { "$ref": "error.json" }
          },
          "required": ["call_id", "ok", "error"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["protocol", "request_id", "sandbox_result"],
  "additionalProperties": false,
  "$defs": {
    "execValue": {
      "title": "exec verb value (§4.1)",
      "type": "object",
      "properties": {
        "exit_code": { "type": "integer" },
        "stdout_b64": { "$ref": "#/$defs/base64" },
        "stderr_b64": { "$ref": "#/$defs/base64" },
        "truncated": { "type": "boolean" },
        "duration_seconds": { "type": "number", "minimum": 0 }
      },
      "required": ["exit_code", "stdout_b64", "stderr_b64", "truncated", "duration_seconds"],
      "additionalProperties": false
    },
    "putFileValue": {
      "title": "put_file verb value (§4.2)",
      "type": "object",
      "properties": {
        "bytes_copied": { "type": "integer", "minimum": 0 },
        "duration_seconds": { "type": "number", "minimum": 0 }
      },
      "required": ["bytes_copied", "duration_seconds"],
      "additionalProperties": false
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
